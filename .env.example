# Copy to .env and fill in the password. Never commit .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=prediction_markets
PGUSER=postgres
PGPASSWORD=

# Every line below is optional; these are the defaults.

# --- venues and services
# LIVE_VENUES=kalshi,poly
# REDIS_URL=redis://127.0.0.1:6379/0
# NET_PROBE_SECONDS=30              # while a venue is unreachable, how often to check it is back
# VPN_PROXY=socks5h://127.0.0.1:40000   # Cloudflare WARP in proxy mode; empty = always direct
# VPN_HOSTS=gamma-api.polymarket.com,clob.polymarket.com,data-api.polymarket.com   # not Kalshi: it refuses WARP
# VPN_RETRY_SECONDS=300             # after falling back to direct, try the proxy again this often

# --- markets store (discover.py)
# MARKET_RETENTION_DAYS=30         # markets closed longer ago than this are deleted, candles too; 0 = never
# MARKET_SYNC_MINUTES=15
# MARKET_CATEGORIES=               # Kalshi categories kept in the markets store; empty = all

# --- the shared Kalshi request budget (every program together)
# KALSHI_REQUESTS_PER_MIN=240
# KALSHI_MAX_PER_SECOND=15         # never more than this in one second (Kalshi counts per second)
# BUDGET_HEADROOM=0.10             # share of the budget never planned for

# --- activity scores and the hot list (activity.py)
# ACTIVITY_HALF_LIFE_MINUTES=60
# HOT_ENTER=1.0                    # contracts per minute to become hot...
# HOT_EXIT=0.5                     # ...and to stop being hot
# OBSERVATION_LAG_SECONDS=120      # how far a scan's listing may run behind the trades

# --- live candles (live.py)
# LIVE_SETTLE_SECONDS=60           # a minute is fetched once it ended this long ago
# LIVE_HOT_OVERLAP_SECONDS=120     # hot markets re-read this much, for trades recorded late
# NEW_MARKET_HOURS=2               # markets this new have their whole history fetched by live.py
# LIVE_FETCH_WORKERS=4

# --- history (backfill.py)
# BACKFILL_DAYS=30

# --- Polymarket (trades.py, aggregate.py, backfill.py --venue poly)
# POLY_REQUESTS_PER_MIN=300         # every Polymarket request from every program
# POLY_MAX_PER_SECOND=8
# POLY_FEED_SECONDS=15              # how often the feed of every trade is read
# POLY_FEED_LAG_SECONDS=30          # coverage claimed up to the feed's newest trade less this
# POLY_LIST_LAG_SECONDS=900         # ...and up to a market list's request time less this

# --- the API (api/)
# API_WORKERS=4                    # processes (set in the service file)
# API_DB_POOL=8                    # database connections per process
# API_RATE_PER_MIN=600             # requests per key per minute, unless the key has its own
# API_BACKFILL_PER_MIN=10          # backfill pushes per key per minute
# API_JOB_LEASE_SECONDS=120        # a running job unheard from this long is taken over
