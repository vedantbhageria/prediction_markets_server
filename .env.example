# Copy to .env and fill in the password. Never commit .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=prediction_markets
PGUSER=postgres
PGPASSWORD=

# --- live collector (live.py). Every line is optional; these are the defaults.
# LIVE_CANDLE_SECONDS=5
# LIVE_POLL_SECONDS=2.5            # how often each venue is sampled
# LIVE_HEARTBEAT_SECONDS=60        # quiet markets still get a candle this often; 5 = store every candle
# LIVE_MAX_CANDLES=120960          # most candles kept per ticker (7 days of 5-second candles)
# LIVE_MAX_MARKETS=500             # markets collected live, per venue, busiest first
# LIVE_MIN_VOLUME_KALSHI=100
# LIVE_MIN_VOLUME_POLY=10000
# LIVE_CATEGORIES=                 # e.g. Crypto,Economics ; empty = all
# LIVE_VENUES=kalshi,poly

# MARKET_RETENTION_DAYS=7          # markets closed longer ago than this are deleted, candles too; 0 = never
# MARKET_SYNC_MINUTES=15
# MARKET_CATEGORIES=               # Kalshi categories kept in the markets store; empty = all
# POLY_MAX_EVENTS=3000

# BACKFILL_DAYS=7
# BACKFILL_WORKERS=4
