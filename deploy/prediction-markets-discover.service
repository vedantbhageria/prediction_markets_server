# prediction_markets market discovery. Lists every open market and imports closed ones, every 15 minutes.
#
# Installed with the others by: sudo bash deploy/install-services.sh
#   systemctl status prediction-markets-discover
#   tail -f ~/logs/discover.log
#   sudo systemctl restart prediction-markets-discover

[Unit]
Description=prediction_markets market discovery
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
User=theonealpha
WorkingDirectory=/home/theonealpha/prediction_markets_server
EnvironmentFile=/home/theonealpha/prediction_markets_server/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/theonealpha/prediction_markets_server/.venv/bin/python discover.py
# SIGINT: each program finishes the request in hand and saves its place.
KillSignal=SIGINT
TimeoutStopSec=90
Restart=always
RestartSec=30
StandardOutput=append:/home/theonealpha/logs/discover.log
StandardError=append:/home/theonealpha/logs/discover.log

[Install]
WantedBy=multi-user.target
