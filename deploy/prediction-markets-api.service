# prediction_markets API. The data API, as four processes. It listens on 127.0.0.1:8000; Tailscale
# Funnel publishes it at https://theonealpha.tail947e08.ts.net:8443.
#
# Installed with the others by: sudo bash deploy/install-services.sh
#   systemctl status prediction-markets-api
#   tail -f ~/logs/api.log
#   sudo systemctl restart prediction-markets-api

[Unit]
Description=prediction_markets API
After=network-online.target postgresql.service redis-server.service tailscaled.service
Wants=network-online.target

[Service]
User=theonealpha
WorkingDirectory=/home/theonealpha/prediction_markets_server
EnvironmentFile=/home/theonealpha/prediction_markets_server/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/theonealpha/prediction_markets_server/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --workers 4
# SIGINT: each program finishes the request in hand and saves its place.
KillSignal=SIGINT
TimeoutStopSec=90
Restart=always
RestartSec=5
StandardOutput=append:/home/theonealpha/logs/api.log
StandardError=append:/home/theonealpha/logs/api.log

[Install]
WantedBy=multi-user.target
