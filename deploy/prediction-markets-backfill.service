# prediction_markets history, Kalshi candles and Polymarket trades. Fills every market's history on leftover budget. When it has nothing
# left it exits, and runs again 15 minutes later to fill whatever is new.
#
# Installed with the others by: sudo bash deploy/install-services.sh
#   systemctl status prediction-markets-backfill
#   tail -f ~/logs/backfill.log
#   sudo systemctl restart prediction-markets-backfill

[Unit]
Description=prediction_markets candle history
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
User=theonealpha
WorkingDirectory=/home/theonealpha/prediction_markets_server
EnvironmentFile=/home/theonealpha/prediction_markets_server/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/theonealpha/prediction_markets_server/.venv/bin/python backfill.py --venue all
# SIGINT: each program finishes the request in hand and saves its place.
KillSignal=SIGINT
TimeoutStopSec=90
Restart=always
RestartSec=900
StandardOutput=append:/home/theonealpha/logs/backfill.log
StandardError=append:/home/theonealpha/logs/backfill.log

[Install]
WantedBy=multi-user.target
