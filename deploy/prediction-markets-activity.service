# prediction_markets activity scores. Scores each discovery scan and publishes the hot list.
#
# Installed with the others by: sudo bash deploy/install-services.sh
#   systemctl status prediction-markets-activity
#   tail -f ~/logs/activity.log
#   sudo systemctl restart prediction-markets-activity

[Unit]
Description=prediction_markets activity scores
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
User=theonealpha
WorkingDirectory=/home/theonealpha/prediction_markets_server
EnvironmentFile=/home/theonealpha/prediction_markets_server/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/theonealpha/prediction_markets_server/.venv/bin/python activity.py
# SIGINT: each program finishes the request in hand and saves its place.
KillSignal=SIGINT
TimeoutStopSec=90
Restart=always
RestartSec=10
StandardOutput=append:/home/theonealpha/logs/activity.log
StandardError=append:/home/theonealpha/logs/activity.log

[Install]
WantedBy=multi-user.target
